# Office-Link 통합 배포 환경변수 템플릿
# 이 파일을 deploy/.env로 복사하고, 실행 전에 비어 있는 필수값을 입력합니다.
# deploy/.env, API 키, 비밀번호, 개인키, 터널 토큰은 Git에 커밋하지 않습니다.

# -----------------------------------------------------------------------------
# 외부 접속 설정
# -----------------------------------------------------------------------------
# 로컬 환경에서 실행할 때의 기본 설정입니다.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=80
PUBLIC_BASE_URL=http://localhost
REFRESH_TOKEN_COOKIE_SECURE=false

# Cloudflare Tunnel을 이용해 HTTPS로 배포할 때는 위 설정 대신 아래 예시를 사용합니다.
# FRONTEND_BIND_ADDRESS=127.0.0.1
# FRONTEND_PORT=80
# PUBLIC_BASE_URL=https://office-link.example.com
# REFRESH_TOKEN_COOKIE_SECURE=true
# Azure 앱의 Redirect URI에도 ${PUBLIC_BASE_URL}/login/oauth2/code/azure를 등록해야 합니다.

# -----------------------------------------------------------------------------
# Planner, Action, RAG 답변 검증용 LLM 설정
# -----------------------------------------------------------------------------
# OpenAI 또는 온프레미스 모델 중 하나의 설정만 활성화합니다. 아래 기본값은 OpenAI입니다.
ONPREM_LLM_BASE_URL=https://api.openai.com/v1
ONPREM_LLM_API_KEY=
PLAN_MODEL=gpt-4.1-mini-2025-04-14
ACTION_MODEL=gpt-4.1-mini-2025-04-14
RAG_VALIDATION_MODEL=gpt-4.1-mini-2025-04-14

# OpenAI 호환 API를 제공하는 온프레미스 LLM 서버를 사용할 때의 예시입니다.
# ONPREM_LLM_BASE_URL=http://GPU_SERVER_IP:11434/v1
# ONPREM_LLM_API_KEY=local-api-key
# PLAN_MODEL=exact-model-id-returned-by-v1-models
# ACTION_MODEL=exact-model-id-returned-by-v1-models
# RAG_VALIDATION_MODEL=exact-model-id-returned-by-v1-models

# 추론 강도와 응답 길이 설정을 지원하는 모델에서 사용합니다.
# 지원하지 않는 모델이나 제공자는 이 값을 무시할 수 있습니다.
PLAN_REASONING_EFFORT=low
ACTION_REASONING_EFFORT=low
RAG_VALIDATION_REASONING_EFFORT=low
LLM_VERBOSITY=low

# -----------------------------------------------------------------------------
# RAG 임베딩 및 OpenAI 기능에 사용하는 별도 API 설정
# -----------------------------------------------------------------------------
# 위에서 온프레미스 LLM을 사용하더라도 RAG 임베딩을 위해 이 API 키가 필요합니다.
OPENAI_API_KEY=
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RAG_REPROCESSING_ENABLED=true

# -----------------------------------------------------------------------------
# Azure OAuth2 사용자 로그인 설정
# -----------------------------------------------------------------------------
# Office-Link용 Azure 앱 등록 화면에서 발급받은 값을 입력합니다.
AZURE_AUTHORITY_TENANT=organizations
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# 사용자 JWT 및 서버 간 OAuth2 토큰 서명 설정
# -----------------------------------------------------------------------------
# JWT_SECRET에는 32자 이상의 새로운 무작위 문자열을 입력합니다.
JWT_SECRET=
OAUTH_JWT_KEY_ID=office-link-key-1
# 새로운 PKCS#8 개인키와 X.509 공개키를 생성하고 각각 한 줄 Base64 값으로 입력합니다.
# Windows에서는 다음 명령으로 생성할 수 있습니다: java .\deploy\GenerateOAuthTestKeys.java
OAUTH_JWT_PRIVATE_KEY_BASE64=
OAUTH_JWT_PUBLIC_KEY_BASE64=

# 서버 간 OAuth Client Secret은 이 파일에 한 번만 정의합니다.
# Docker Compose가 같은 값을 인증 서버인 Final Backend와 해당 호출 서버 양쪽에
# 각각 주입하므로, 각 서버 폴더에 별도의 .env 파일을 만들 필요는 없습니다.
# 양쪽에 전달되는 값이 다르면 Client Credentials 방식의 토큰 발급이 실패합니다.
#
# CHAT_BACKEND_CLIENT_SECRET: Final Backend -> AI Agent 호출
# CHAT_BACKEND_WORKHUB_CLIENT_SECRET: Final Backend -> Workhub Backend 직접 실행
# AI_AGENT_CLIENT_SECRET: AI Agent -> MCP Server 및 로그 API 호출
# MCP_SERVER_CLIENT_SECRET: MCP Server -> Workhub Backend 및 로그 API 호출
# WORKHUB_BACKEND_CLIENT_SECRET: Workhub Backend -> 로그 API 호출
#
# 각 서버 클라이언트마다 서로 다른 24자 이상의 무작위 문자열을 생성해 입력합니다.
CHAT_BACKEND_CLIENT_SECRET=
CHAT_BACKEND_WORKHUB_CLIENT_SECRET=
AI_AGENT_CLIENT_SECRET=
MCP_SERVER_CLIENT_SECRET=
WORKHUB_BACKEND_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# PostgreSQL 데이터베이스 설정
# -----------------------------------------------------------------------------
FINAL_POSTGRES_DB=metanet
FINAL_POSTGRES_USER=metanet
FINAL_POSTGRES_PASSWORD=
WORKHUB_POSTGRES_DB=workhub
WORKHUB_POSTGRES_USER=workhub
WORKHUB_POSTGRES_PASSWORD=

# 기존 Docker 볼륨의 데이터를 재사용할 때만 해당 볼륨 이름으로 변경합니다.
FINAL_POSTGRES_VOLUME=office-link-demo_final-postgres-data
WORKHUB_POSTGRES_VOLUME=office-link-demo_workhub-postgres-data

# -----------------------------------------------------------------------------
# 시뮬레이션 및 운영 도구 설정
# -----------------------------------------------------------------------------
REALTIME_SIMULATION_ENABLED=true
KAFKA_UI_PORT=18090

# cloudflared 서비스를 사용할 때만 필요합니다.
# Cloudflare Zero Trust의 Tunnel 설정에서 발급받으며, 실제 토큰은 커밋하지 않습니다.
CLOUDFLARE_TUNNEL_TOKEN=
